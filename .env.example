# HandoffProof environment. Copy to .env (git-ignored). Never commit real values.

# --- Meta Model API (required for model diagnosis, maps, and repair proposals) ---
META_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Official Meta Responses API base URL.
META_API_BASE_URL=https://api.meta.ai/v1
# Optional fallback key name used by the Meta client when META_API_KEY is empty.
MODEL_API_KEY=

# --- Per-phase model routing (F1; all optional, defaults reproduce the above) ---
# Each of the six phases (SHORT: INTAKE=intake_summary, DEPENDENCY=dependency_map,
# DIAGNOSIS=diagnosis, REPAIR=repair_proposal, ASSESSMENT=assessment,
# VERIFICATION=verification) accepts four overrides:
#   HANDOFF_MODEL_<SHORT>    model ID (default: META_MODEL_ID)
#   HANDOFF_PROVIDER_<SHORT> meta-responses | openai-chat (default: meta-responses)
#   HANDOFF_BASE_URL_<SHORT> endpoint base URL (default: META_API_BASE_URL)
#   HANDOFF_KEY_ENV_<SHORT>  name of the env var holding this phase's key
#                            (default: the META_API_KEY/MODEL_API_KEY value)
# Examples (commented out to keep default behaviour):
# Route the repair phase to Wonder on the Meta API:
# HANDOFF_MODEL_REPAIR=muse-wonder-1.0
# Route a phase to Muse Spark Open via Together AI (OpenAI-compatible):
# HANDOFF_MODEL_REPAIR=meta-models/muse-spark-open
# HANDOFF_PROVIDER_REPAIR=openai-chat
# HANDOFF_BASE_URL_REPAIR=https://api.together.xyz/v1
# HANDOFF_KEY_ENV_REPAIR=TOGETHER_API_KEY
# Unknown provider kinds and unresolvable keys fail closed at startup.

# --- Private mode (F5; optional, default off) ---
# off    : routing above, unchanged.
# local  : every phase runs on the local Muse Glimmer endpoint; any request to a
#          non-loopback host (including api.meta.ai) is refused. No Meta key needed.
#          Audio transcription is a cloud API and is refused; use --transcript.
# hybrid : intake_summary, dependency_map and diagnosis run locally; phases routed
#          to the cloud lose every source-reading tool and see evidence only.
# HANDOFF_PRIVATE_MODE=off
# Local OpenAI-compatible endpoint (must be loopback). Default is Ollama
# (`ollama run muse-glimmer`, Ollama 0.32.7+). vLLM: http://127.0.0.1:8000/v1 with
# --tool-call-parser muse_glimmer; llama.cpp: http://127.0.0.1:8080/v1.
# HANDOFF_GLIMMER_BASE_URL=http://127.0.0.1:11434/v1
# HANDOFF_GLIMMER_MODEL=muse-glimmer
# Optional; local servers ignore it (Ollama accepts any placeholder).
# HANDOFF_GLIMMER_API_KEY=

# --- HandoffProof console ---
# Used to sign in to the local Control Room. Change this before any shared or production use.
HANDOFF_CONSOLE_TOKEN=
# Public address where users open this console. Slack requires HTTPS here;
# GitHub also accepts a loopback HTTP callback for local use.
HANDOFF_PUBLIC_URL=http://127.0.0.1:8787
# Optional controller-held ownership declaration outside the repository under test.
HANDOFFPROOF_OWNERSHIP_FILE=

# --- Slack OAuth (Settings -> Add to Slack) ---
# Create a Slack app, enable Incoming Webhooks, add scope incoming-webhook,
# and register: <HANDOFF_PUBLIC_URL>/api/integrations/slack/callback
HANDOFF_SLACK_CLIENT_ID=
HANDOFF_SLACK_CLIENT_SECRET=
# Optional operator-managed fallback webhook. Prefer OAuth above.
HANDOFF_SLACK_WEBHOOK=
# Optional store path. Blank = OS user config dir under HandoffProof/.
HANDOFF_SLACK_STORE=
# Encrypts the stored Slack webhook at rest. Use a long random value in production.
HANDOFF_SLACK_ENCRYPTION_KEY=
# Optional aliases accepted by the server when the HANDOFF_* names are empty.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- GitHub OAuth (Settings -> Connect GitHub) ---
# Register a GitHub OAuth app with callback:
# <HANDOFF_PUBLIC_URL>/api/integrations/github/callback
HANDOFF_GITHUB_CLIENT_ID=
HANDOFF_GITHUB_CLIENT_SECRET=
# Optional store path. Blank = OS user config dir under HandoffProof/.
HANDOFF_GITHUB_STORE=
# Encrypts the stored GitHub OAuth tokens at rest. Use a long random value in production.
HANDOFF_GITHUB_ENCRYPTION_KEY=
# Optional aliases accepted by the server when the HANDOFF_* names are empty.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Bring Your Own App registry store. Blank = OS user config dir.
HANDOFF_APPLICATIONS_STORE=
HANDOFF_APPLICATIONS_ENCRYPTION_KEY=

# --- Advanced endpoint overrides (normally leave as shown) ---
HANDOFF_SLACK_BASE_URL=https://slack.com
HANDOFF_GITHUB_BASE_URL=https://github.com
HANDOFF_GITHUB_API_BASE_URL=https://api.github.com

# Demo-app and drill sandbox variables (DATABASE_URL, MAIL_API_TOKEN,
# SCHEDULER_TOKEN, ports) are generated per run by the controller and are
# intentionally not set here.
